<odoo>
    <record id="view_partner_form_client_prefs" model="ir.ui.view">
        <field name="name">res.partner.form.client.preferences</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Client Preferences">
                    <!-- Wrap in a group container for proper alignment -->
                    <group>
                        <group string="SALE PREFERENCES" class="col-6">
                            <field name="client_type"/>
                            <field name="preferred_property_type"/>
                        </group>
                        <group string="CONTACT PREFERENCES" class="col-6">
                            <field name="preferred_contact_hours" widget="float_time"/>
                            <field name="preferred_contact_method"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
